@baseUrl = http://localhost:3000/api/v1

# Get a session ID
# @name sID
GET {{baseUrl}}/test/hello

###
@sessionID = {{ sID.response.headers.set-cookie }}
# Reserve seats before making the order
POST {{baseUrl}}/seats/select
Cookie: sessionID
content-type: application/json

{
    "seatNumber": "A2",
    "date": "2025-09-15"
}

