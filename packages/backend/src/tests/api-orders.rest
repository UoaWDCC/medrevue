@sessionID = {{ sID.response.headers.set-cookie }}
# @title Create Order
# @description This endpoint creates a new order in the system.
# NOTE: this doesn't work at the moment because you need to set the seat lock before being able to make any kind of order.
POST {{baseUrl}}/orders/
Cookie: sessionID
content-type: application/json

{
    "firstName": "John",
    "lastName": "Doe",
    "email": "test@test.com",
    "phone": "+1234567890",
    "isStudent": true,
    "studentCount": 0,
    "selectedDate": "2025-09-15",
    "selectedSeats": [
        { "rowLabel": "A", "number": 2, "seatType": "Standard" }
    ],
    "totalPrice": 30.00
}

